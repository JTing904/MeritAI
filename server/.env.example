# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Locally: postgresql://postgres:<password>@localhost:5432/meritai
DATABASE_URL=
# Used only by the test suite (a separate database that tests wipe). Must be on localhost: anything else is refused.
TEST_DATABASE_URL=
# Migrations on Supabase need the direct / session-pooler URL. Leave empty locally.
DIRECT_URL=

# Random 32 bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Separate random 32 bytes, used to encrypt team leaders' AI keys at rest.
AI_KEY_SECRET=

# Which environment this is: development (your computer) | production. Leave empty on Vercel.
APP_ENV=
# "true" enables the one-tap developer login and the other /api/dev tools, but only together with
# APP_ENV=development, never with NODE_ENV=production and never on Vercel. The server refuses to start
# when DEV_LOGIN is set (anything but empty/false) in production or on Vercel.
DEV_LOGIN=false

# Comma-separated browser origins allowed to call the API (the web app / PWA): exact, no trailing slash.
# e.g. https://meritai.vercel.app  (locally defaults to http://localhost:8081)
WEB_ORIGINS=

PORT=3000

# Evidence files (M4). STORAGE_DRIVER: local (files on this machine; not on Vercel) | supabase (not built yet).
STORAGE_DRIVER=local
# Where the local driver keeps files. Empty: server/uploads (gitignored).
UPLOAD_DIR=
# How browsers reach this API, for the signed links that open evidence files (AUTH_SECRET signs them).
# Empty: http://localhost:3000 (the tablet reaches it through adb reverse).
PUBLIC_API_URL=
# Uploads stop for everyone once evidence files reach this many bytes (Supabase free storage is 1 GB).
# Empty: 900 MB (943718400).
MAX_SITE_STORAGE_BYTES=

# App builds older than this (x.y.z, sent as X-App-Version) get 426 UPDATE_REQUIRED. Empty: 0.0.0 (none refused).
MIN_APP_VERSION=

# General request limit (lib/rate-limit.ts generalLimitFromEnv): per signed-in user, else per client IP,
# per window; over it → 429 RATE_LIMITED with Retry-After. Defaults 600 / 1200 per 600 s. RATE_LIMIT_DISABLED=true: off.
RATE_LIMIT_USER_MAX=
RATE_LIMIT_IP_MAX=
RATE_LIMIT_WINDOW_SEC=
RATE_LIMIT_DISABLED=
