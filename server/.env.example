# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Locally: postgresql://postgres:<password>@localhost:5432/meritai
DATABASE_URL=
# Used only by the test suite (a separate database that tests wipe). Must be on localhost: anything else is refused.
TEST_DATABASE_URL=
# Migrations on Supabase need the direct / session-pooler URL. Leave empty locally.
DIRECT_URL=

# Random 32 bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# M6: encrypts leaders' AI keys at rest (AES-256-GCM). Separate random 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production (the server refuses to start without it). Development and tests fall back to a
# fixed dev secret with a warning. Changing it makes every saved key unreadable (leaders save them again).
AI_KEY_SECRET=

# M6 AI. AI_MOCK=1: every key goes to the offline mock provider (tests and development only; refused in
# production). Model ids (defaults in brackets):
#   GEMINI_MODEL_LIGHT [gemini-flash-lite-latest]  (reading briefs, 怎么做, and grading's last resort)
#   GEMINI_GOOD_CHAIN [gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash]
#     grading tries these smartest first; each has its own daily quota; a used-up one moves to the next
#   CLAUDE_MODEL_LIGHT [claude-haiku-4-5], CLAUDE_MODEL_GOOD [claude-sonnet-5]          (测试版)
#   OPENAI_MODEL_LIGHT [gpt-5-mini], OPENAI_MODEL_GOOD [gpt-5.6]                        (测试版)
# Gemini free-tier limits per key and model: every good-chain model GEMINI_GOOD_RPD [20] a day and
# GEMINI_GOOD_RPM [5] a minute; the light model GEMINI_LIGHT_RPD [500] / GEMINI_LIGHT_RPM [15]; single models
# with GEMINI_MODEL_LIMITS="gemini-3.8-flash=20/5,gemini-3.5-flash=30/10" (day/minute). Claude / OpenAI:
# AI_RPM [30] a minute. AI_JOB_KICK=off: AI jobs only run from the tick (the tests set it).
AI_MOCK=
# Only for the opt-in live test (tests/ai-live.test.ts, run with AI_LIVE=1). Never commit a real key.
GEMINI_TEST_API_KEY=

# Which environment this is: development (your computer) | production. Leave empty on Vercel.
APP_ENV=
# "true" enables the one-tap developer login and the other /api/dev tools, but only together with
# APP_ENV=development, never with NODE_ENV=production and never on Vercel. The server refuses to start
# when DEV_LOGIN is set (anything but empty/false) in production or on Vercel.
DEV_LOGIN=false

# Comma-separated browser origins allowed to call the API (the web app / PWA): exact, no trailing slash.
# e.g. https://meritai.vercel.app  (locally defaults to http://localhost:8081)
WEB_ORIGINS=

PORT=3000

# Evidence files (M4). STORAGE_DRIVER: local (files on this machine; not on Vercel) | supabase (not built yet).
STORAGE_DRIVER=local
# Where the local driver keeps files. Empty: server/uploads (gitignored).
UPLOAD_DIR=
# How browsers reach this API, for the signed links that open evidence files (AUTH_SECRET signs them).
# Empty: http://localhost:3000 (the tablet reaches it through adb reverse).
PUBLIC_API_URL=
# Uploads stop for everyone once evidence files reach this many bytes (Supabase free storage is 1 GB).
# Empty: 900 MB (943718400).
MAX_SITE_STORAGE_BYTES=

# App builds older than this (x.y.z, sent as X-App-Version) get 426 UPDATE_REQUIRED. Empty: 0.0.0 (none refused).
MIN_APP_VERSION=

# General request limit (lib/rate-limit.ts generalLimitFromEnv): per signed-in user, else per client IP,
# per window; over it → 429 RATE_LIMITED with Retry-After. Defaults 600 / 1200 per 600 s. RATE_LIMIT_DISABLED=true: off.
RATE_LIMIT_USER_MAX=
RATE_LIMIT_IP_MAX=
RATE_LIMIT_WINDOW_SEC=
RATE_LIMIT_DISABLED=

# Reminders tick (M5): POST /api/internal/tick needs `Authorization: Bearer <CRON_SECRET>`. Empty: the route
# doesn't exist (404). Production: the same value as the CRON_SECRET repository secret the GitHub Actions
# schedule (.github/workflows/tick.yml) sends every 10 minutes, together with TICK_URL. Random 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The local dev server runs the tick in-process every 60 s and doesn't need it.
CRON_SECRET=
