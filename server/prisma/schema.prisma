// MeritAI data model. The datasource URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GITHUB
  GOOGLE
}

enum Locale {
  zh
  en
}

/// Highlighter ("荧光笔") colours, in assignment order (shared/constants.ts HIGHLIGHTERS).
enum Highlighter {
  lemon
  gum
  mint
  sky
  tang
  lilac
  lime
  aqua
}

enum ProjectStatus {
  /// Being set up by the leader; only the leader sees it; no invite code yet.
  DRAFT
  ACTIVE
  /// Past the deadline, waiting for the leader to confirm it was submitted (M5). Everything still works;
  /// the tick ends it automatically 7 days after the deadline.
  AWAITING_CONFIRM
  /// Ended (M5): read-only until purgeAfter (endedAt + 14 days), then the tick deletes it for good.
  ENDED
}

enum MemberRole {
  LEADER
  MEMBER
}

enum TaskKind {
  CODE
  DOC
  RESEARCH
  DESIGN
  MEETING
}

enum TaskStatus {
  TODO
  DOING
  REVIEWING
  DONE
  HALF
  FAIL
}

/// How the draft's tasks were produced.
enum PlanSource {
  MANUAL
  RULES
  MODEL
  AI
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  VOID
}

/// Why a pending swap stopped counting (REQUIREMENTS §13).
enum SwapVoidReason {
  SWITCHED
  STARTED
  SWAPPED_ELSEWHERE
  LEFT
  RESPLIT
  /// The leader deleted the project for everyone.
  PROJECT_DELETED
  /// The project ended (M5).
  PROJECT_ENDED
}

/// Who a notification went to, shown in its meta line (全组都收到 / 只有你收到 / 只有组长收到 / 只有你和组长收到).
enum NotificationAudience {
  GROUP
  ONLY_YOU
  ONLY_LEADER
  YOU_AND_LEADER
}

enum NotificationType {
  SWAP_REQUEST
  SWAP_ACCEPTED
  SWAP_DECLINED
  SWAP_EXPIRED
  SWAP_VOID
  MEMBER_NEEDS_PACKAGE
  MEMBER_LEFT
  MEMBER_REMOVED
  REMOVED_YOU
  TASK_ADDED
  TASK_MOVED_IN
  TASK_MOVED_OUT
  RESPLIT
  PACKAGE_ASSIGNED
  LEADER_TRANSFERRED
  SUBMITTED
  GRADED
  GRADED_OUTSIDE
  OVERRIDDEN
  WAITING_ON_YOU
  PREREQ_DONE
  PROJECT_DELETED
  PROJECT_RESTORED
  // M5: reminders (services/tick.ts) and the project lifecycle.
  TASK_DUE_SOON
  TASK_DUE_REVIEW
  TASK_OWNERLESS_SOON
  TASK_OVERDUE
  TASK_OWNERLESS_OVERDUE
  PREREQ_BLOCKED
  WEEKLY_SUMMARY
  PROJECT_DUE
  PROJECT_AUTO_END_SOON
  PROJECT_ENDED
  PROJECT_REOPENED
  PROJECT_DELETE_SOON
  TASK_DELAYED
  // M6: AI
  AI_REVIEW_FAILED
  AI_KEY_PROBLEM
  CHOICE_CHANGED
}

/// Entries of the project feed (动态).
enum ActivityType {
  PLAN_CONFIRMED
  JOINED
  LEFT
  REMOVED
  PICKED
  SWITCHED
  SWAPPED
  ASSIGNED
  TASK_ADDED
  TASK_MOVED
  TASK_STARTED
  RESPLIT
  LEADER_TRANSFERRED
  SUBMITTED
  WITHDRAWN
  GRADED
  OVERRIDDEN
  MEETING_DONE
  START_UNDONE
  PREREQ_SET
  PROJECT_DELETED
  PROJECT_RESTORED
  PROJECT_ENDED
  PROJECT_REOPENED
  TASK_DELAYED
  CHOICE_CHANGED
}

/// The leader's grade of an attempt (M4). SELF: a meeting task its owner marked done.
/// EXCELLENT, PASS and SELF earn the task's points; HALF half (rounded); FAIL none.
enum Grade {
  EXCELLENT
  PASS
  HALF
  FAIL
  SELF
}

/// DRAFT: evidence being collected; PENDING: 等组长审核; GRADED.
enum AttemptStatus {
  DRAFT
  PENDING
  GRADED
}

enum EvidenceKind {
  FILE
  LINK
}

// ─── M6: AI ───────────────────────────────────────────────────────────────────

/// Which AI service a leader's key belongs to (REQUIREMENTS §13 「AI（M6）」). Claude and OpenAI are 测试版.
enum AiProvider {
  GEMINI
  CLAUDE
  OPENAI
}

/// What the last call with the key said. QUOTA counts only for the usage day it was set on (lib/ai/usage.ts).
enum AiKeyStatus {
  OK
  INVALID
  QUOTA
}

/// An attempt's AI review. SKIPPED: the daily AI review limit was reached, so the leader grades it.
enum AiState {
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum AiJobKind {
  BRIEF
  HOWTO
  GRADE
}

enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ChoiceType {
  PICK_N
  METHOD
}

enum AiLevel {
  LOW
  MID
  HIGH
}

model User {
  id             String   @id @default(cuid())
  name           String
  /// Verified email from GitHub or Google. Accounts with the same verified email merge.
  email          String?  @unique
  githubUsername String?  @unique
  /// Language for push notifications (the app syncs it from the device choice).
  locale         Locale   @default(zh)
  pushEnabled    Boolean  @default(true)
  weeklyEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// M6: the account's AI key (one per account; every project this user leads uses it). The key itself is
  /// only stored encrypted (lib/ai/crypto.ts: AES-256-GCM with AI_KEY_SECRET) and never leaves the server.
  aiProvider         AiProvider?
  aiKeyCipher        String?
  aiKeyLast4         String?
  aiKeyStatus        AiKeyStatus?
  aiKeyCheckedAt     DateTime?
  /// 「我已满 18 岁」 ticked when the key was saved.
  aiAdultConfirmedAt DateTime?
  /// AI_KEY_PROBLEM goes out once per usage day and problem: "<QUOTA|INVALID>:<usage day>" of the last one sent.
  aiKeyNotice        String?

  sessions        Session[]
  accounts        AuthAccount[]
  memberships     Member[]
  createdProjects Project[]      @relation("ProjectCreator")
  sentInvites     Invite[]       @relation("InviteSender")
  notifications   Notification[]
  idempotencyKeys IdempotencyKey[]
  aiUsage         AiUsage[]
}

/// A signed-in device. Only the SHA-256 hash of the bearer token is stored.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A GitHub or Google login linked to a user (at most one of each per user).
model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Project {
  id              String        @id @default(cuid())
  name            String
  /// 简称 / 课程代码, e.g. "CS302" (optional).
  shortCode       String?
  /// 课程或团队名称 (optional).
  courseName      String?
  /// 组别, e.g. "第 7 组" (optional).
  groupLabel      String?
  /// Tag colour on project cards; auto-picked to avoid the creator's other projects.
  color           Highlighter
  /// Whole-project deadline (required). Tasks without a due date use it.
  deadline        DateTime
  /// IANA time zone, e.g. "Asia/Kuala_Lumpur". Reminders and date-only due dates use it.
  timezone        String
  /// Language for AI-generated task names and group messages (defaults to the leader's).
  locale          Locale        @default(zh)
  /// Team size including the leader (2–8).
  teamSize        Int
  /// The leader only manages: packages = teamSize - 1 and the leader is not ranked.
  leaderManages   Boolean       @default(false)
  status          ProjectStatus @default(DRAFT)
  /// Wizard step the draft was left on (1–6), for "继续编辑".
  draftStep       Int           @default(1)
  planSource      PlanSource?
  /// Text of the brief (typed, or extracted from the uploaded file); kept for re-parsing and AI later.
  /// Omitted from every query unless selected (lib/db.ts OMIT): only the brief endpoints read it. At most
  /// MAX_BRIEF_TEXT_BYTES (services/brief.ts cuts a longer text at a line and adds a note).
  briefText       String?
  /// UTF-8 bytes of briefText; null when there is none. Lists use it instead of loading the text.
  briefBytes      Int?
  briefFileName   String?
  /// M6: a brief the free rules can't read (a photo or scanned PDF) kept for the AI (storage key
  /// "<projectId>/brief/<id>.<ext>"), and its sniffed type. Deleted with the project's files.
  briefFileKey    String?
  briefFileMime   String?
  inviteCode      String?       @unique
  /// "owner/name" when a GitHub repo is connected (M8).
  repoFullName    String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activatedAt     DateTime?
  /// Bumped on every change to packages, owners, members, or a task's package/owner/status/start/points,
  /// so a re-split preview can tell it went stale (STALE_PREVIEW).
  packagesVersion Int           @default(0)
  /// Cache version (hardening B2): bumped by database triggers (migration cache_versions) on every write
  /// to this row or to a row that belongs to the project (members, packages, features, milestones, tasks,
  /// attempts, evidence, checklist items, grade changes, invites, swaps) and when a member's name changes.
  /// Conditional GETs (lib/etag.ts) hash it into their ETag. Never written by the app.
  version         Int           @default(0)
  /// 为所有人删除项目: hidden from everyone at once; the leader who did it (deletedById) can restore it
  /// until purgeAfter (deletedAt + 7 days), after which the purge removes it for good.
  deletedAt       DateTime?
  deletedById     String?
  /// When the project is deleted for good: deletedAt + 7 days (deleted for everyone), endedAt + 14 days
  /// (ENDED), the earlier of the two when both apply. Null otherwise.
  purgeAfter      DateTime?
  /// M5: when the project went AWAITING_CONFIRM (= the deadline it passed); null in any other status.
  awaitingSince   DateTime?
  /// M5: when it ended (ENDED only), by whom (null: ended automatically, or the member row is gone).
  endedAt         DateTime?
  endedById       String?
  /// Ended by the tick: 7 days in AWAITING_CONFIRM without the leader acting.
  endedAuto       Boolean       @default(false)

  createdBy          User                @relation("ProjectCreator", fields: [createdById], references: [id])
  deletedBy          Member?             @relation("ProjectDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  endedBy            Member?             @relation("ProjectEnder", fields: [endedById], references: [id], onDelete: SetNull)
  members            Member[]
  packages           Package[]
  tasks              Task[]
  features           Feature[]
  milestones         Milestone[]
  invites            Invite[]
  retiredInviteCodes RetiredInviteCode[]
  swapRequests       SwapRequest[]
  notifications      Notification[]
  activity           ActivityEvent[]
  reminders          ReminderLog[]
  aiJobs             AiJob[]
  choiceQuestions    ChoiceQuestion[]

  @@index([createdById])
  @@index([purgeAfter])
  @@index([deletedById])
  @@index([endedById])
  @@index([status])
}

model Member {
  id                String      @id @default(cuid())
  projectId         String
  userId            String
  role              MemberRole  @default(MEMBER)
  color             Highlighter
  joinedAt          DateTime    @default(now())
  /// Set when the member leaves or is removed. History (points, report) is kept.
  leftAt            DateTime?
  /// Removed by the leader: cannot come back with the invite code.
  removed           Boolean     @default(false)
  /// When the leader was told this member has no package while none is free (MEMBER_NEEDS_PACKAGE).
  /// Sent once; cleared when the member gets a package.
  packageReminderAt DateTime?

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           Package?
  tasks             Task[]          @relation("TaskOwner")
  startedTasks      Task[]          @relation("TaskStarter")
  swapsSent         SwapRequest[]   @relation("SwapRequester")
  swapsReceived     SwapRequest[]   @relation("SwapTarget")
  activity          ActivityEvent[]
  submittedAttempts Attempt[]       @relation("AttemptSubmitter")
  gradedAttempts    Attempt[]       @relation("AttemptGrader")
  addedEvidence     Evidence[]      @relation("EvidenceAdder")
  gradeChanges      GradeChange[]   @relation("GradeChanger")
  deletedProjects   Project[]       @relation("ProjectDeleter")
  endedProjects     Project[]       @relation("ProjectEnder")

  @@unique([projectId, userId])
  @@index([userId])
}

/// An equal share of the work. Picked first come, first served (M3).
model Package {
  id        String   @id @default(cuid())
  projectId String
  /// 1-based number shown as 任务包 {index}.
  index     Int
  /// Member who picked it (one package per member).
  ownerId   String?  @unique
  createdAt DateTime @default(now())

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner          Member?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  swapsRequested SwapRequest[] @relation("SwapRequesterPackage")
  swapsTargeted  SwapRequest[] @relation("SwapTargetPackage")

  @@unique([projectId, index])
}

/// A feature group (功能分组): code, report section and tests of one feature stay together.
model Feature {
  id        String @id @default(cuid())
  projectId String
  name      String
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  /// Short tag, e.g. "M1" or "S1".
  label     String
  name      String
  dueAt     DateTime
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id             String     @id @default(cuid())
  projectId      String
  /// Per-project number (#12) used in commit messages without an AI key.
  number         Int
  title          String
  description    String?
  kind           TaskKind   @default(DOC)
  /// Contribution points in tenths (125 = 12.5 分). An active project's tasks sum to exactly 1000.
  points         Int
  /// Null → the project deadline applies.
  dueAt          DateTime?
  /// What the planner suggested (shown as "AI 原本建议 …" when the leader changed it).
  suggestedDueAt DateTime?
  estimateHours  Float?
  order          Int
  featureId      String?
  milestoneId    String?
  packageId      String?
  /// Member doing the task (the package owner; a started task stays with whoever started it).
  ownerId        String?
  /// Derived from the attempts (lib/grading.ts statusFor): REVIEWING while one is PENDING, else by `grade`.
  status         TaskStatus @default(TODO)
  /// The counting attempt's current grade (best rank; the latest on a tie); null without a graded attempt.
  grade          Grade?
  /// When the counting grade was earned (M4 spec §2); null while not finished. Sorts 已完成.
  finishedAt     DateTime?
  /// 前置任务: the task this one waits for (one at a time; a hint, never a block).
  prereqTaskId   String?
  /// 作业要求（原文）: the brief item's lines (markers stripped) and its line range [briefFrom, briefTo)
  /// in Project.briefText. Null for typed descriptions and tasks added by hand. Omitted from every query
  /// unless selected (lib/db.ts OMIT): only the task page shows it.
  briefExcerpt   String?
  briefFrom      Int?
  briefTo        Int?
  /// A part made by splitLargeTasks (shows 「这一项拆成了 N 个任务」).
  briefSplit     Boolean    @default(false)
  startedAt      DateTime?
  /// Who started it (开始做; later also evidence, commits, marking done). Kept when the task changes
  /// hands, cleared when it is released. A package counts as started only through its owner's own start.
  startedById    String?
  /// The due date the leader set by hand; a later deadline change gives it back (never past the deadline).
  leaderDueAt    DateTime?
  /// M6 怎么做: 2–8 short steps. `howtoByAi` / `checklistByAi`: written by the AI and not edited since
  /// (「✨ AI 写的」); a leader or owner edit clears the flag.
  howto          String[]   @default([])
  howtoByAi      Boolean    @default(false)
  checklistByAi  Boolean    @default(false)
  /// M6: the 选择题 option this task was generated from (改选 deletes and regenerates these).
  choiceOptionId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  choiceOption ChoiceOption?   @relation(fields: [choiceOptionId], references: [id], onDelete: SetNull)
  feature      Feature?        @relation(fields: [featureId], references: [id], onDelete: SetNull)
  milestone    Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  package      Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  owner        Member?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startedBy    Member?         @relation("TaskStarter", fields: [startedById], references: [id], onDelete: SetNull)
  prereqTask   Task?           @relation("TaskPrereq", fields: [prereqTaskId], references: [id], onDelete: SetNull)
  waitingTasks Task[]          @relation("TaskPrereq")
  attempts     Attempt[]
  checklist    ChecklistItem[]
  evidence     Evidence[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([packageId])
  @@index([ownerId])
  @@index([prereqTaskId])
  @@index([startedById])
  @@index([featureId])
  @@index([milestoneId])
  @@index([choiceOptionId])
}

/// One submission round of a task (第 N 次). At most one attempt per task is not GRADED; the services
/// guarantee it under the project row lock (a partial unique index can't be expressed in this schema,
/// so a later migrate dev would drop one added by hand). Old attempts, their evidence, grades and
/// notes are kept while the project exists.
model Attempt {
  id             String        @id @default(cuid())
  taskId         String
  /// 第 N 次, 1-based.
  no             Int
  status         AttemptStatus @default(DRAFT)
  submittedById  String?
  submittedAt    DateTime?
  /// submittedAt after the effective due (报告里记「迟交」).
  late           Boolean       @default(false)
  grade          Grade?
  /// The leader's 理由 (HALF/FAIL) or 评语 (optional otherwise).
  gradeNote      String?
  gradedById     String?
  gradedAt       DateTime?
  /// 合格（组长自评）: the leader submitted their own task.
  selfGraded     Boolean       @default(false)
  /// 组长代为完成 · 证据在 App 外交了.
  outsideApp     Boolean       @default(false)
  outsideNote    String?
  /// Meeting tasks: 开了什么、决定了什么 + who came (member ids, the owner included) + who didn't
  /// (snapshot of the members active at completion who weren't ticked; never the owner).
  meetingSummary String?
  attendeeIds    String[]      @default([])
  absentIds      String[]      @default([])
  /// M6 AI review: null when the AI wasn't asked (no key, leader's own task, meeting). The score itself is
  /// never stored; `grade` holds its band. gradeNote = the AI's summary. aiFailReason: AiFailReason
  /// (shared/types.ts) when FAILED or SKIPPED.
  aiState        AiState?
  aiFailReason   String?
  gradedByAi     Boolean       @default(false)
  aiProvider     AiProvider?
  aiModel        String?
  aiReasons      String[]      @default([])
  aiSuggestions  String[]      @default([])
  createdAt      DateTime      @default(now())

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy Member?       @relation("AttemptSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  gradedBy    Member?       @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  evidence    Evidence[]
  changes     GradeChange[]

  @@unique([taskId, no])
  @@index([taskId, status])
  @@index([submittedById])
  @@index([gradedById])
}

/// A file or link handed in with an attempt.
model Evidence {
  id         String       @id @default(cuid())
  attemptId  String
  /// Denormalised from the attempt: evidence counts and the project's storage sum.
  taskId     String
  kind       EvidenceKind
  /// File name as shown (sanitised) or the link's display text.
  name       String
  /// LINK only.
  url        String?
  /// FILE only: "<projectId>/<taskId>/<24 hex chars>.<ext>" (lib/storage.ts).
  storageKey String?      @unique
  sizeBytes  Int?
  /// FILE only: the canonical type of the sniffed content (never the client's).
  mimeType   String?
  addedById  String?
  createdAt  DateTime     @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedBy Member? @relation("EvidenceAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([attemptId])
  @@index([addedById])
}

/// 做到这些才算完成: the task's checklist, ordered.
model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  done      Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
}

/// 推翻评级: the leader changed an attempt's grade. Undoing sets undoneAt and restores fromGrade.
model GradeChange {
  id         String    @id @default(cuid())
  attemptId  String
  fromGrade  Grade
  toGrade    Grade
  reason     String
  byId       String?
  createdAt  DateTime  @default(now())
  undoneAt   DateTime?
  undoneById String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  by      Member? @relation("GradeChanger", fields: [byId], references: [id], onDelete: SetNull)

  @@index([attemptId, createdAt])
  @@index([byId])
}

/// Invitation by email or GitHub username; shown on the invitee's home screen.
model Invite {
  id             String       @id @default(cuid())
  projectId      String
  invitedById    String
  /// Lower-cased.
  email          String?
  /// Lower-cased, without "@".
  githubUsername String?
  status         InviteStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([githubUsername])
  @@index([projectId])
  @@index([invitedById])
}

/// Codes replaced by "重新生成", so joining with one says it expired rather than "not found".
model RetiredInviteCode {
  code      String   @id
  projectId String
  retiredAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// 互换请求: a member with a not-started package asks the owner of another not-started package.
model SwapRequest {
  id                 String          @id @default(cuid())
  projectId          String
  requesterId        String
  targetId           String
  /// Package indexes are snapshotted in notification payloads; these go null if a re-split deletes the package.
  requesterPackageId String?
  targetPackageId    String?
  status             SwapStatus      @default(PENDING)
  voidReason         SwapVoidReason?
  /// Member whose action voided it (who started, switched, left or was removed; the leader for a re-split).
  voidedById         String?
  createdAt          DateTime        @default(now())
  /// createdAt + 72 h. Expired lazily (no scheduler yet).
  expiresAt          DateTime
  /// When the status left PENDING.
  respondedAt        DateTime?

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester        Member         @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target           Member         @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  requesterPackage Package?       @relation("SwapRequesterPackage", fields: [requesterPackageId], references: [id], onDelete: SetNull)
  targetPackage    Package?       @relation("SwapTargetPackage", fields: [targetPackageId], references: [id], onDelete: SetNull)
  notifications    Notification[]

  @@index([projectId, status])
  @@index([requesterId, status])
  @@index([targetId, status])
  @@index([requesterPackageId])
  @@index([targetPackageId])
}

/// One row per recipient. `payload` is a NotificationPayload (shared/types.ts), names and indexes snapshotted.
model Notification {
  id        String                @id @default(cuid())
  userId    String
  projectId String?
  type      NotificationType
  audience  NotificationAudience?
  /// Shown under 「跟我有关」.
  mine      Boolean               @default(true)
  payload   Json
  swapId    String?
  createdAt DateTime              @default(now())
  readAt    DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  swap    SwapRequest? @relation(fields: [swapId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@index([projectId])
  @@index([swapId])
}

/// The project feed (动态). `payload` is an ActivityPayload (shared/types.ts).
model ActivityEvent {
  id        String       @id @default(cuid())
  projectId String
  actorId   String?
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   Member? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt, id])
  @@index([actorId])
}

/// Reminders already sent (M5, services/tick.ts). The tick inserts a reminder's key with ON CONFLICT DO
/// NOTHING in the same transaction as its notification and sends it only when the row was new. The key
/// holds what makes a reminder new (e.g. "due24:<taskId>:<ownerMemberId|none>:<effective due ISO>"), so a
/// later due date or another owner arms it again. No cache-version trigger: nobody sees these rows.
model ReminderLog {
  key       String   @id
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A fixed-window rate-limit counter (lib/rate-limit.ts). `key` names the limit and the caller,
/// e.g. "join:<userId>"; blockedUntil is set while a lockout runs.
model RateLimitBucket {
  key          String    @id
  count        Int
  windowStart  DateTime
  blockedUntil DateTime?
}

/// The first result of a create request sent with an Idempotency-Key header (lib/idempotency.ts).
/// A retry with the same key from the same user within 24 h gets this result back instead of
/// creating the thing again. `status` is null while the first request is still running.
model IdempotencyKey {
  userId    String
  key       String
  /// "POST /api/…" route pattern of the first request; the same key on another route is refused.
  route     String
  status    Int?
  body      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
}

// ─── M6: AI ───────────────────────────────────────────────────────────────────

/// Model calls made with a key per usage day (Pacific date for Gemini, UTC otherwise) and model: each Gemini
/// model has its own free daily quota (lib/ai/usage.ts). The column is named "tier" in the database.
model AiUsage {
  userId String
  day    String
  /// The model id the calls went to, e.g. "gemini-3.8-flash".
  model  String @map("tier")
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, model])
}

/// Background AI work (services/ai-jobs.ts). Enqueued in the write's transaction, run after the commit and by
/// the tick. `dedupeKey` makes enqueueing idempotent; `payload` holds what the job was made for (e.g. the
/// attempt's submittedAt), `result` the outcome or, while running, its progress.
model AiJob {
  id         String      @id @default(cuid())
  kind       AiJobKind
  projectId  String
  taskId     String?
  attemptId  String?
  dedupeKey  String      @unique
  status     AiJobStatus @default(QUEUED)
  tries      Int         @default(0)
  runAfter   DateTime    @default(now())
  leaseUntil DateTime?
  error      String?
  payload    Json?
  result     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([projectId, kind, createdAt])
  @@index([taskId])
}

/// A 选择题 found in the brief (任选几题 / 选一种做法).
model ChoiceQuestion {
  id        String     @id @default(cuid())
  projectId String
  prompt    String
  /// The brief's own words, when the AI quoted them.
  quote     String?
  type      ChoiceType
  pickCount Int
  order     Int

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options ChoiceOption[]

  @@index([projectId])
}

model ChoiceOption {
  id          String   @id @default(cuid())
  questionId  String
  /// "A", "B", … (assigned by the server in the AI's order).
  key         String
  label       String
  summary     String
  hours       Float
  material    AiLevel
  difficulty  AiLevel
  pros        String[] @default([])
  cons        String[] @default([])
  recommended Boolean  @default(false)
  picked      Boolean  @default(false)
  /// The tasks this option makes (ChoiceTaskTemplate[], services/choices.ts), points already in tenths.
  tasksJson   Json
  order       Int

  question ChoiceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([questionId, key])
}
