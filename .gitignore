# Dependencies and build output (every package)
node_modules/
dist/
dist-web/
coverage/
*.tsbuildinfo

# Secrets: never commit. Only .env.example files are tracked.
.env*
!.env.example
*.pem
*.jks
*.keystore
*.p8
*.p12
google-services.json
service-account*.json
credentials*.json

# Built Android packages (published through GitHub Releases, never committed)
*.apk
*.aab

# Evidence files (local storage driver) and the test suites' copies
server/uploads/
server/.uploads-test*/

# Generated code
server/src/generated/
app/android/
app/ios/
app/.expo/
app/expo-env.d.ts

# Tools
.vercel
.DS_Store
npm-debug.log*

# Local-only documents
REQUIREMENTS-v1-original.md
